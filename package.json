{
  "name": "sulai",
  "version": "0.0.0",
  "private": true,
  "description": "Traceable source foundations for evolving human and AI project state.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulai-atelier/sulai.git"
  },
  "homepage": "https://github.com/sulai-atelier/sulai#readme",
  "bugs": {
    "url": "https://github.com/sulai-atelier/sulai/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/core",
    "packages/experimental-claude-code",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test \"packages/*/test/*.test.ts\"",
    "cli": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
